<%#
  Comprobante de aporte inicial / ingreso / retiro / retiro total (A4 apaisado),
  renderizado con Grover - ver app/services/request_receipt_pdfs/generate.rb.

  Locals:
    data - el Hash de RequestReceiptPdfs::DocumentData#call
%>
<%
  assets = InvestorMonthlyReportPdfs::Assets
  kind = data[:kind]
  legal = {
    aporte: 'Este comprobante deja constancia del aporte inicial de capital realizado por el inversor y del alta de su cuenta personal en Winbit, bajo las condiciones del servicio indicadas.',
    ingreso: 'Este comprobante deja constancia del ingreso de capital realizado por el inversor a su cuenta personal en Winbit.',
    retiro: 'Este comprobante deja constancia del retiro de capital solicitado por el inversor desde su cuenta personal en Winbit.',
    retiro_total: 'Este comprobante deja constancia del retiro total del capital solicitado por el inversor desde su cuenta personal en Winbit.',
  }[kind]
  withdrawal = %i[retiro retiro_total].include?(kind)

  rows = [ [ 'Inversor', data[:investor_name], nil, false ], [ 'Fecha', data[:date_long], nil, false ] ]
  rows << [ { aporte: 'Importe aportado', ingreso: 'Importe ingresado' }.fetch(kind, 'Importe retirado'), data[:amount_label], nil, false ]
  if data[:fee_label]
    rows << [ 'Comisión de gestión', data[:fee_label], "#{data[:fee_percentage]}% de la nueva rentabilidad positiva", false ]
  end
  rows << [ withdrawal ? 'Medio de retiro' : 'Medio de ingreso', data[:medium], nil, true ]
  if kind == :aporte
    rows << [ 'Tipo de cuenta', "Cuenta #{data[:account_type][:name]}", "Comisión del #{data[:account_type][:percentage]}% sobre la nueva rentabilidad positiva", false ]
  end
  if kind == :retiro_total && data[:result][:amount].positive?
    rows << [ 'Resultado neto', data[:result][:label], "Desde el #{data[:result][:since_short]}, neto de comisiones", false ]
  end
  total_label = { aporte: 'Capital inicial', ingreso: 'Capital tras el ingreso' }.fetch(kind, 'Capital tras el retiro')
%>
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title><%= data[:title] %> &middot; <%= data[:investor_name] %></title>
<style>
@font-face { font-family: "Plex"; font-weight: 400; src: url(<%= assets.font_data_uri(:sans_regular) %>) format("truetype"); }
@font-face { font-family: "Plex"; font-weight: 500; src: url(<%= assets.font_data_uri(:sans_medium) %>) format("truetype"); }
@font-face { font-family: "Plex"; font-weight: 600; src: url(<%= assets.font_data_uri(:sans_semibold) %>) format("truetype"); }
@font-face { font-family: "Plex"; font-weight: 700; src: url(<%= assets.font_data_uri(:sans_bold) %>) format("truetype"); }
@font-face { font-family: "PlexC"; font-weight: 500; src: url(<%= assets.font_data_uri(:condensed_medium) %>) format("truetype"); }
@font-face { font-family: "PlexC"; font-weight: 600; src: url(<%= assets.font_data_uri(:condensed_semibold) %>) format("truetype"); }
@font-face { font-family: "PlexC"; font-weight: 700; src: url(<%= assets.font_data_uri(:condensed_bold) %>) format("truetype"); }

@page { size: 297mm 210mm; margin: 0; }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 297mm; height: 210mm; }
body { font-family: "Plex"; background: #0D0F0E; color: #ECE4D5; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.page { position: relative; width: 297mm; height: 210mm; overflow: hidden; display: flex; flex-direction: column; }
.top { position: relative; flex: 1; padding: 16mm 18mm 0 18mm; background: #0D0F0E; }
.bg { position: absolute; top: 0; right: 0; width: 150mm; height: 100%;
  background: url(<%= assets.data_uri(:receipt_back) %>) center 38% / cover no-repeat; }
.bg::after { content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, #0D0F0E 0%, rgba(13,15,14,.82) 30%, rgba(13,15,14,.25) 100%); }
.logo { position: relative; height: 13mm; }
.tag { position: absolute; top: 17mm; right: 18mm; text-align: right; z-index: 2; }
.tag .lbl { font-family: "PlexC"; font-weight: 600; font-size: 8.5pt; letter-spacing: .18em; color: #A7AAA2; text-transform: uppercase; }
.tag .num { font-family: "PlexC"; font-weight: 500; font-size: 12pt; color: #ECE4D5; margin-top: 1mm; letter-spacing: .04em; }
.table { position: relative; width: 170mm; margin-top: 12mm; }
.row { display: flex; align-items: baseline; border-bottom: .3mm solid #28312D; padding: 3.6mm 0 3mm; }
.k { width: 62mm; flex: none; font-family: "PlexC"; font-weight: 600; font-size: 11pt; letter-spacing: .08em; text-transform: uppercase; color: #479785; }
.v { flex: 1; font-family: "PlexC"; font-weight: 500; font-size: 17pt; letter-spacing: .01em; }
.row.small .v { font-family: "Plex"; font-weight: 400; font-size: 9.5pt; color: #c9c3b6; overflow-wrap: anywhere; }
.v .sub { display: block; font-family: "Plex"; font-size: 9pt; color: #A7AAA2; margin-top: .8mm; letter-spacing: 0; }
.total { display: flex; align-items: baseline; padding: 6mm 0 0; }
.total .k { font-size: 12.5pt; color: #479785; padding-right: 5mm; line-height: 1.3; }
.total .v { font-family: "PlexC"; font-weight: 600; font-size: 26pt; color: #ECE4D5; }
.foot { height: 44mm; background: #ECE4D5; color: #0D0F0E; display: flex; align-items: center; padding: 0 18mm; gap: 10mm; }
.foot .t { width: 100mm; white-space: nowrap; }
.foot h1 { font-family: "PlexC"; font-weight: 700; font-size: 15pt; letter-spacing: .04em; text-transform: uppercase; color: #39836D; }
.foot .em { font-size: 8.5pt; color: #555; margin-top: 1.5mm; }
.foot .em b { color: #39836D; font-weight: 600; }
.foot .legal { flex: 1; border-left: .3mm solid #c9c0ae; padding-left: 8mm; font-size: 8.5pt; line-height: 1.55; color: #3a3d3b; }
.foot .ct { text-align: right; font-size: 8.5pt; line-height: 1.7; color: #555; }
.foot .ct b { color: #39836D; font-weight: 600; }
.foot .ct a { color: inherit; text-decoration: none; }
</style>
</head>
<body>
<div class="page">
  <div class="top">
    <div class="bg"></div>
    <img class="logo" src="<%= assets.data_uri(:receipt_logo) %>" alt="Winbit">
    <% if data[:operation_number].present? %>
      <div class="tag"><div class="lbl">N.º de operación</div><div class="num"><%= data[:operation_number] %></div></div>
    <% end %>
    <div class="table">
      <% rows.each do |label, value, sub, small| %>
        <div class="row<%= ' small' if small %>"><div class="k"><%= label %></div><div class="v"><%= value %><% if sub %><span class="sub"><%= sub %></span><% end %></div></div>
      <% end %>
      <div class="total"><div class="k"><%= total_label %></div><div class="v"><%= data[:capital_label] %></div></div>
    </div>
  </div>
  <div class="foot">
    <div class="t"><h1><%= data[:title] %></h1><div class="em">Emitido por <b>Winbit</b> · <%= data[:date_short] %></div></div>
    <div class="legal"><%= legal %></div>
    <div class="ct">Consultas<br><a href="mailto:contacto@winbit.com.ar"><b>contacto@winbit.com.ar</b></a><br><a href="https://wa.me/5491141783126"><b>+54 9 11 4178-3126</b></a><br><a href="https://winbit.com.ar">winbit.com.ar</a></div>
  </div>
</div>
</body>
</html>
