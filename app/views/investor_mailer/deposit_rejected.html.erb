<div style="font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.6; color: #222222; max-width: 600px;">
  <p style="margin: 0 0 14px 0;"><%= saludo %>, <%= @first_name %> ¿cómo estás?</p>

  <p style="margin: 0 0 14px 0;">Te informamos que no pudimos procesar el ingreso de <strong><%= @amount_label %></strong> solicitado <%= solicitado(@request) %>.</p>

  <% if @show_reason %>
    <p style="margin: 0 0 14px 0;"><strong>Motivo:</strong> <%= @reason %></p>
  <% end %>

  <p style="margin: 0;">Si tenés alguna duda o querés volver a realizar la solicitud, respondé este correo y te ayudamos.</p>

  <%= render partial: 'investor_mailer/signature' %>
</div>
