<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;background:#FFFFFF;">
  <div style="max-width:600px;margin:0 auto;padding:24px 20px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.6;color:#2B2F2D;">
    <%= @body_html.html_safe %>

    <% unless @body_has_button %>
      <p style="margin:24px 0 0 0;">
        <a href="<%= EmailCampaigns::TemplateRenderer.app_url %>" style="<%= EmailCampaigns::TemplateRenderer::BUTTON_STYLE %>">Ver mi cuenta en la app &rarr;</a>
      </p>
    <% end %>

    <%= render partial: 'investor_mailer/signature_card' %>
  </div>
</body>
</html>
