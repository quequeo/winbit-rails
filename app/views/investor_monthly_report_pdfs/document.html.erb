<%#
  Monthly investor report PDF (5+N pages), rendered via Grover (Chrome
  headless / Puppeteer) - see app/services/investor_monthly_report_pdfs/generate.rb.

  Locals:
    data - the Hash built by InvestorMonthlyReportPdfs::DocumentData#call

  Design ported from docs/reporte_mensual_kit/plantilla/reporte.html.j2
  (IBM Plex Sans/Condensed, same CSS custom properties as the admin/app
  redesign). Unlike the kit's script (one operations page per report), the
  "Operaciones del mes" section stays paginated via data[:ops_pages] since a
  month's trade count is unbounded - see DocumentData::OPS_PAGE_LIMIT.
%>
<% year = data[:year_opening][:date].split('/').last %>
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Reporte mensual &middot; <%= data[:month_label_full] %> &middot; <%= data[:investor_name] %></title>
<style>
@font-face { font-family: "Plex"; font-weight: 400; src: url(<%= InvestorMonthlyReportPdfs::Assets.font_data_uri(:sans_regular) %>) format("truetype"); }
@font-face { font-family: "Plex"; font-weight: 500; src: url(<%= InvestorMonthlyReportPdfs::Assets.font_data_uri(:sans_medium) %>) format("truetype"); }
@font-face { font-family: "Plex"; font-weight: 600; src: url(<%= InvestorMonthlyReportPdfs::Assets.font_data_uri(:sans_semibold) %>) format("truetype"); }
@font-face { font-family: "Plex"; font-weight: 700; src: url(<%= InvestorMonthlyReportPdfs::Assets.font_data_uri(:sans_bold) %>) format("truetype"); }
@font-face { font-family: "PlexC"; font-weight: 400; src: url(<%= InvestorMonthlyReportPdfs::Assets.font_data_uri(:condensed_regular) %>) format("truetype"); }
@font-face { font-family: "PlexC"; font-weight: 500; src: url(<%= InvestorMonthlyReportPdfs::Assets.font_data_uri(:condensed_medium) %>) format("truetype"); }
@font-face { font-family: "PlexC"; font-weight: 600; src: url(<%= InvestorMonthlyReportPdfs::Assets.font_data_uri(:condensed_semibold) %>) format("truetype"); }
@font-face { font-family: "PlexC"; font-weight: 700; src: url(<%= InvestorMonthlyReportPdfs::Assets.font_data_uri(:condensed_bold) %>) format("truetype"); }

:root {
  --carbon: #0D0F0E; --verde: #39836D; --verde2: #479785; --crema: #ECE4D5;
  --gris: #A7AAA2; --borde: #28312D; --rojo: #C96C67;
  --tinta: #2F3532; --tinta2: #5E625C; --linea-crema: #D4CBBA;
}
@page { size: 297mm 210mm; margin: 0; }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { font-family: "Plex", sans-serif; color: var(--tinta); font-size: 11px; }
.page { width: 297mm; height: 210mm; position: relative; overflow: hidden; page-break-after: always; }
.page:last-child { page-break-after: auto; }
.dark { background: var(--carbon); color: var(--crema); }
.light { background: var(--crema); color: var(--tinta); }
.cond { font-family: "PlexC", sans-serif; }
.pos { color: var(--verde); } .dark .pos { color: var(--verde2); }
.neg { color: var(--rojo); }
.neu { color: var(--tinta2); } .dark .neu { color: var(--gris); }

/* ---------- cabecera y pie de páginas internas ---------- */
.inner { padding: 38px 56px 0; height: 100%; display: flex; flex-direction: column; }
/* Evolución's table grows with the number of months in the report year (up
   to 12) - .foot is absolutely positioned and reserves no space in the flex
   flow above, so without this the table/acumulado bar can run under it for
   investors with many months of history. */
.inner-evo { padding-bottom: 48px; }
.head { display: flex; justify-content: space-between; align-items: center; height: 40px; }
.head img { height: 34px; }
.pnum { font-family: "PlexC"; font-weight: 700; font-size: 20px; color: var(--verde); display: flex; align-items: center; gap: 8px; }
.dark .pnum { color: var(--verde2); }
.pnum::before { content: ""; width: 42px; height: 1px; background: currentColor; }
.title { font-family: "PlexC"; font-weight: 700; font-size: 40px; line-height: 1; text-transform: uppercase; letter-spacing: -0.2px; margin-top: 30px; }
.sub { font-size: 14px; color: var(--tinta2); margin-top: 10px; }
.dark .sub { color: var(--gris); }
.label { font-size: 9.5px; font-weight: 600; letter-spacing: 0.6px; text-transform: uppercase; color: var(--verde); }
.dark .label { color: var(--verde2); }
.foot { position: absolute; left: 56px; right: 56px; bottom: 22px; border-top: 1px solid var(--verde); padding-top: 9px;
        font-size: 8.5px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--tinta2); display: flex; justify-content: space-between; }
.dark .foot { color: var(--gris); border-top-color: var(--borde); }

/* ---------- 1 · portada ---------- */
.cover .left { position: absolute; left: 0; top: 0; bottom: 0; width: 52%; padding: 44px 60px; }
.cover .right { position: absolute; right: 0; top: 0; bottom: 0; width: 48%; border-left: 2px solid var(--verde2); }
.cover .right img { width: 100%; height: 100%; object-fit: cover; display: block; }
.cover .logo { height: 50px; }
.cover h1 { font-family: "PlexC"; font-weight: 700; font-size: 50px; line-height: 1.02; text-transform: uppercase; margin-top: 170px; }
.cover h1 span { display: block; color: var(--verde2); }
.cover .rule { height: 1px; background: var(--verde); margin: 30px 0 26px; width: 100%; opacity: .8; }
.cover .period { font-family: "PlexC"; font-weight: 600; font-size: 19px; letter-spacing: 1px; }
.cover .who { position: absolute; left: 60px; bottom: 150px; }
.cover .who .name { font-size: 28px; font-weight: 400; margin-top: 8px; }

/* ---------- 2 · resumen ---------- */
.res-rule { height: 1px; background: var(--verde); margin-top: 24px; }
.res { display: grid; grid-template-columns: 1fr 1px 1.35fr; column-gap: 48px; margin-top: 50px; flex: 0 0 auto; }
.res .vline { background: var(--verde); }
.res .blk { padding-bottom: 38px; }
.res .blk + .blk { border-top: 1px solid var(--linea-crema); padding-top: 40px; }
.big { font-family: "PlexC"; font-weight: 600; font-size: 66px; line-height: 1; margin-top: 20px; letter-spacing: -0.5px; }
.big2 { font-size: 52px; }
.note { font-size: 11px; color: var(--tinta2); margin-top: 10px; }
.kpi { padding: 0 0 30px; }
.kpi + .kpi { border-top: 1px solid var(--linea-crema); padding-top: 30px; }
.kpi .row { display: flex; align-items: baseline; margin-top: 12px; }
.kpi .p { font-family: "PlexC"; font-weight: 700; font-size: 52px; line-height: 1; width: 55%; letter-spacing: -0.3px; }
.kpi .u { font-family: "PlexC"; font-weight: 600; font-size: 34px; line-height: 1; }
.fnote { position: absolute; left: 56px; bottom: 58px; font-size: 10px; color: var(--tinta2); }

/* ---------- 3 · evolución ---------- */
.ev-top { display: flex; justify-content: space-between; align-items: flex-start; }
.ev-top .title { margin-top: 26px; }
.saldo { border-left: 1px solid var(--verde); padding: 4px 0 4px 26px; margin-top: 28px; min-width: 300px; }
.saldo .row { display: flex; justify-content: space-between; align-items: baseline; gap: 30px; margin-top: 10px; }
.saldo .d { font-size: 12px; color: var(--gris); }
.saldo .v { font-family: "PlexC"; font-weight: 700; font-size: 26px; }
/* Fixed height (not the SVG's native 1000x260 aspect ratio, which rendered
   ~270px tall at page width and was the main cause of the table/acumulado
   bar running under the footer for investors with many months of history -
   see ChartSvg's preserveAspectRatio="none"). */
.chart { margin-top: 14px; height: 122px; }
table { width: 100%; border-collapse: collapse; }
.tev { margin-top: 10px; }
.tev th { font-size: 8.5px; font-weight: 600; letter-spacing: .5px; color: var(--gris); text-align: right; padding: 8px 6px; border-bottom: 1px solid var(--verde2); text-transform: uppercase; }
.tev th:first-child, .tev td:first-child { text-align: left; }
.tev td { font-size: 11px; padding: 6.5px 6px; text-align: right; border-bottom: 1px solid var(--borde); font-variant-numeric: tabular-nums; }
.tev td:first-child { font-weight: 600; }
.tev tr.cur td { background: #151B18; font-weight: 600; }
.tev.denso td { padding: 3.6px 6px; font-size: 10.3px; } .tev.denso + .acum { padding: 8px 18px; }
.acum { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--verde2); background: #131A17; padding: 12px 18px; margin-top: 2px; }
.acum .t { font-family: "PlexC"; font-weight: 600; font-size: 16px; letter-spacing: .5px; }
.acum .vals { display: flex; gap: 70px; font-family: "PlexC"; font-weight: 700; font-size: 25px; }
.fn { font-size: 9.5px; color: var(--gris); margin-top: 9px; }

/* ---------- 4 · operaciones ---------- */
.activos { display: flex; gap: 46px; margin-top: 8px; padding-bottom: 10px; border-bottom: 1px solid var(--verde); }
.activos div { font-size: 12px; color: var(--tinta2); }
.activos b { font-family: "PlexC"; font-weight: 700; font-size: 15px; color: var(--verde); margin-right: 7px; }
.tops th { font-size: 8.5px; font-weight: 600; letter-spacing: .5px; color: var(--tinta2); text-align: left; padding: 8px 6px 6px; border-bottom: 1px solid var(--linea-crema); text-transform: uppercase; }
.tops td { font-size: 10.5px; padding: 3.3px 6px; border-bottom: 1px solid var(--linea-crema); font-variant-numeric: tabular-nums; }
.tops .r { text-align: right; }
.tops td.b { font-weight: 600; }
.tops.holgado td { padding: 8px 6px; font-size: 11px; }
.tops.denso td { padding: 1.8px 6px; font-size: 9.6px; }
.opnote { font-size: 9.5px; color: var(--tinta2); margin-top: 8px; }
.sumbar { position: absolute; left: 56px; right: 56px; bottom: 50px; display: grid; grid-template-columns: repeat(6, 1fr);
          border-top: 1px solid var(--verde); }
.sumbar > div { text-align: center; padding: 7px 4px 6px; }
.sumbar > div + div { border-left: 1px solid var(--linea-crema); }
.sumbar .k { font-size: 8.5px; font-weight: 600; letter-spacing: .6px; color: var(--tinta2); text-transform: uppercase; }
.sumbar .v { font-family: "PlexC"; font-weight: 700; font-size: 23px; margin-top: 2px; line-height: 1.1; }

/* ---------- 5 · contratapa ---------- */
.back .left { position: absolute; left: 0; top: 0; bottom: 0; width: 56%; padding: 44px 60px; }
.back .right { position: absolute; right: 0; top: 0; bottom: 0; width: 44%; border-left: 2px solid var(--verde2); }
.back .right img { width: 100%; height: 100%; object-fit: cover; display: block; }
.back .logo { height: 58px; }
.back .contact { margin-top: 180px; width: 380px; }
.back .contact .rule { height: 1px; background: var(--verde); margin: 12px 0 22px; }
.back .contact p { font-size: 15px; margin-bottom: 14px; }
.back .contact p.web { color: var(--verde2); }
.back .legal { position: absolute; left: 60px; right: 60px; bottom: 96px; border-top: 1px solid var(--borde); padding-top: 18px; }
.back .legal p { font-size: 10.5px; color: var(--gris); line-height: 1.45; margin-top: 7px; }
.back .mes { position: absolute; left: 60px; bottom: 40px; font-family: "PlexC"; font-weight: 700; font-size: 24px; color: var(--verde2); }
</style>
</head>
<body>

<!-- 1 · PORTADA -->
<section class="page dark cover">
  <div class="left">
    <img class="logo" src="<%= InvestorMonthlyReportPdfs::Assets.data_uri(:logo_dark) %>" alt="Winbit">
    <h1>Reporte mensual<span>de rendimiento</span></h1>
    <div class="rule"></div>
    <div class="period"><%= data[:month_label_full] %></div>
    <div class="who">
      <div class="label">Inversor</div>
      <div class="name"><%= data[:investor_name] %></div>
    </div>
  </div>
  <div class="right"><img src="<%= InvestorMonthlyReportPdfs::Assets.data_uri(:cover) %>"></div>
</section>

<!-- 2 · RESUMEN -->
<section class="page light">
  <div class="inner">
    <div class="head"><img src="<%= InvestorMonthlyReportPdfs::Assets.data_uri(:logo_light) %>" alt="Winbit"><div class="pnum">02</div></div>
    <div class="title">Resumen del portafolio</div>
    <div class="res-rule"></div>
    <div class="res">
      <div>
        <div class="blk">
          <div class="label">Valor del portafolio</div>
          <div class="big">USD <%= data[:portfolio_value] %></div>
          <div class="note">Valor del portafolio al <%= data[:as_of_date] %></div>
        </div>
        <div class="blk">
          <div class="label">Capital aportado neto</div>
          <div class="big big2">USD <%= data[:net_contributed] %></div>
          <div class="note">Ingresos menos retiros.</div>
        </div>
      </div>
      <div class="vline"></div>
      <div>
        <div class="kpi">
          <div class="label">Rendimiento mensual &middot; <%= data[:month_label_full] %></div>
          <div class="row"><div class="p <%= data[:monthly][:class] %>"><%= data[:monthly][:percent] %></div><div class="u"><%= data[:monthly][:usd] %></div></div>
        </div>
        <div class="kpi">
          <div class="label">Rendimiento acumulado <%= year %></div>
          <div class="row"><div class="p <%= data[:ytd][:class] %>"><%= data[:ytd][:percent] %></div><div class="u"><%= data[:ytd][:usd] %></div></div>
        </div>
        <div class="kpi">
          <div class="label">Rendimiento acumulado desde el ingreso</div>
          <div class="row"><div class="p <%= data[:since_entry][:class] %>"><%= data[:since_entry][:percent] %></div><div class="u"><%= data[:since_entry][:usd] %></div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="fnote">Rendimiento neto = rendimiento operativo &minus; costo del servicio aplicado al per&iacute;odo.</div>
  <div class="foot"><span>Reporte mensual de rendimiento &middot; <%= data[:month_label_full] %></span><span><%= data[:investor_name] %></span></div>
</section>

<!-- 3 · EVOLUCIÓN -->
<section class="page dark">
  <div class="inner inner-evo">
    <div class="head"><img src="<%= InvestorMonthlyReportPdfs::Assets.data_uri(:logo_dark) %>" alt="Winbit"><div class="pnum">03</div></div>
    <div class="ev-top">
      <div>
        <div class="title">Evoluci&oacute;n del portafolio</div>
        <div class="sub">Historial mensual <%= year %></div>
      </div>
      <div class="saldo">
        <div class="label">Saldo inicial <%= year %></div>
        <div class="row"><span class="d"><%= data[:year_opening][:date] %></span><span class="v">USD <%= data[:year_opening][:value] %></span></div>
      </div>
    </div>
    <div class="label" style="margin-top:18px">Evoluci&oacute;n del valor del portafolio</div>
    <div class="chart"><%= data[:chart_svg].html_safe %></div>
    <% dense_evo = data[:evo_rows].size > 8 %>
    <table class="tev<%= ' denso' if dense_evo %>">
      <thead><tr><th>Mes</th><th>Valor portafolio (USD)</th><th>Ingresos (USD)</th><th>Retiros (USD)</th><th>Costo servicio* (USD)</th><th>Rendimiento %</th><th>Rendimiento (USD)</th></tr></thead>
      <tbody>
        <% data[:evo_rows].each do |row| %>
          <tr<%= ' class="cur"'.html_safe if row[:last] %>>
            <td><%= row[:label] %></td>
            <td><%= row[:portfolio_value] %></td>
            <td><%= row[:deposits] %></td>
            <td><%= row[:withdrawals] %></td>
            <td><%= row[:service_cost] %></td>
            <td class="<%= row[:return_percent_class] %>"><%= row[:return_percent] %></td>
            <td class="<%= row[:return_usd_class] %>"><%= row[:return_usd] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="acum"><span class="t">ACUMULADO <%= year %></span><span class="vals"><span class="<%= data[:evo_total][:class] %>"><%= data[:evo_total][:percent] %></span><span><%= data[:evo_total][:usd] %></span></span></div>
    <div class="fn">* Importe correspondiente al servicio de gesti&oacute;n aplicado en el per&iacute;odo indicado.</div>
  </div>
  <div class="foot"><span>Reporte mensual de rendimiento &middot; <%= data[:month_label_full] %></span><span><%= data[:investor_name] %></span></div>
</section>

<!-- 4+ · OPERACIONES DEL MES (paginated - see DocumentData::OPS_PAGE_LIMIT) -->
<% data[:ops_pages].each do |page| %>
  <% density = page[:trades].size <= 10 ? ' holgado' : (page[:trades].size > 12 ? ' denso' : '') %>
  <section class="page light">
    <div class="inner">
      <div class="head"><img src="<%= InvestorMonthlyReportPdfs::Assets.data_uri(:logo_light) %>" alt="Winbit"><div class="pnum"><%= page[:page_number] %></div></div>
      <div class="title" style="margin-top:22px">Operaciones del mes</div>
      <% if page[:first] %>
        <div class="sub" style="margin-top:6px">Detalle operativo &middot; <%= data[:month_label_full] %></div>
        <div class="label" style="margin-top:14px">Activos operados</div>
        <div class="activos">
          <% page[:assets].each do |asset| %>
            <div><b><%= asset[:code] %></b><%= asset[:name] %></div>
          <% end %>
        </div>
      <% else %>
        <div class="sub" style="margin-top:6px">Detalle operativo &middot; <%= data[:month_label_full] %> (continuaci&oacute;n)</div>
      <% end %>
      <table class="tops<%= density %>">
        <thead><tr>
          <th>Fecha</th><th>Activo</th><th>Direcci&oacute;n</th><th class="r">Apertura</th><th class="r">Cierre</th>
          <th class="r">Resultado (USD)</th><th class="r">Rend. %</th><th class="r">Ratio</th>
        </tr></thead>
        <tbody>
          <% page[:trades].each do |trade| %>
            <tr>
              <td class="b"><%= trade[:date] %></td>
              <td class="b"><%= trade[:asset] %></td>
              <td><%= trade[:direction] %></td>
              <td class="r"><%= trade[:opened_at] %></td>
              <td class="r"><%= trade[:closed_at] %></td>
              <td class="r b <%= trade[:result_class] %>"><%= trade[:result_usd] %></td>
              <td class="r <%= trade[:result_class] %>"><%= trade[:result_percent] %></td>
              <td class="r b"><%= trade[:ratio] %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if page[:last] %>
        <div class="opnote">Ratio: relaci&oacute;n entre el resultado de la operaci&oacute;n y el riesgo inicialmente asumido. BE: break even (resultado cercano a cero). USD: resultado atribuido a esta cuenta.</div>
      <% end %>
    </div>
    <% if page[:last] %>
      <div class="sumbar">
        <div><div class="k">Operaciones</div><div class="v"><%= page[:ops_summary][:count] %></div></div>
        <div><div class="k">Positivas</div><div class="v pos"><%= page[:ops_summary][:positive] %></div></div>
        <div><div class="k">Negativas</div><div class="v neg"><%= page[:ops_summary][:negative] %></div></div>
        <div><div class="k">Break even</div><div class="v neu"><%= page[:ops_summary][:break_even] %></div></div>
        <div><div class="k">Resultado neto</div><div class="v <%= page[:ops_summary][:net_result_class] %>"><%= page[:ops_summary][:net_result] %></div></div>
        <div><div class="k">Rendimiento del mes</div><div class="v <%= data[:monthly][:class] %>"><%= page[:ops_summary][:monthly_return_percent] %></div></div>
      </div>
    <% end %>
    <div class="foot"><span>Reporte mensual de rendimiento &middot; <%= data[:month_label_full] %></span><span><%= data[:investor_name] %></span></div>
  </section>
<% end %>

<!-- 5 · CONTRATAPA -->
<section class="page dark back">
  <div class="left">
    <img class="logo" src="<%= InvestorMonthlyReportPdfs::Assets.data_uri(:logo_dark) %>" alt="Winbit">
    <div class="contact">
      <div class="label">Contacto</div>
      <div class="rule"></div>
      <p>+54 9 11 4178-3126</p>
      <p>winbit.cfds@gmail.com</p>
      <p class="web">winbit.com.ar</p>
    </div>
    <div class="legal">
      <div class="label">Informaci&oacute;n legal</div>
      <p>Este documento es confidencial y fue emitido para uso exclusivo del titular del portafolio.</p>
      <p>Material informativo. La operatoria con derivados implica riesgo y los resultados pueden variar seg&uacute;n las condiciones de mercado.</p>
      <p>Resultados hist&oacute;ricos. No garantizan resultados futuros.</p>
    </div>
    <div class="mes"><%= data[:month_label_full] %></div>
  </div>
  <div class="right"><img src="<%= InvestorMonthlyReportPdfs::Assets.data_uri(:back) %>"></div>
</section>

</body>
</html>
