<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Reporte mensual · {{ mes_txt }} · {{ inversor }}</title>
<style>
@font-face { font-family: "Plex"; src: url("{{ fonts }}/IBMPlexSans-Regular.ttf"); font-weight: 400; }
@font-face { font-family: "Plex"; src: url("{{ fonts }}/IBMPlexSans-Medium.ttf"); font-weight: 500; }
@font-face { font-family: "Plex"; src: url("{{ fonts }}/IBMPlexSans-SemiBold.ttf"); font-weight: 600; }
@font-face { font-family: "Plex"; src: url("{{ fonts }}/IBMPlexSans-Bold.ttf"); font-weight: 700; }
@font-face { font-family: "PlexC"; src: url("{{ fonts }}/IBMPlexSansCondensed-Regular.ttf"); font-weight: 400; }
@font-face { font-family: "PlexC"; src: url("{{ fonts }}/IBMPlexSansCondensed-Medium.ttf"); font-weight: 500; }
@font-face { font-family: "PlexC"; src: url("{{ fonts }}/IBMPlexSansCondensed-SemiBold.ttf"); font-weight: 600; }
@font-face { font-family: "PlexC"; src: url("{{ fonts }}/IBMPlexSansCondensed-Bold.ttf"); font-weight: 700; }

:root {
  --carbon: #0D0F0E; --verde: #39836D; --verde2: #479785; --crema: #ECE4D5;
  --gris: #A7AAA2; --borde: #28312D; --rojo: #C96C67;
  --tinta: #2F3532; --tinta2: #5E625C; --linea-crema: #D4CBBA;
}
@page { size: 297mm 210mm; margin: 0; }
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { font-family: "Plex", sans-serif; color: var(--tinta); font-size: 11px; }
.page { width: 297mm; height: 210mm; position: relative; overflow: hidden; page-break-after: always; }
.page:last-child { page-break-after: auto; }
.dark { background: var(--carbon); color: var(--crema); }
.light { background: var(--crema); color: var(--tinta); }
.cond { font-family: "PlexC", sans-serif; }
.pos { color: var(--verde); } .dark .pos { color: var(--verde2); }
.neg { color: var(--rojo); }
.neu { color: var(--tinta2); } .dark .neu { color: var(--gris); }

/* ---------- cabecera y pie de páginas internas ---------- */
.inner { padding: 38px 56px 0; height: 100%; display: flex; flex-direction: column; }
.head { display: flex; justify-content: space-between; align-items: center; height: 40px; }
.head img { height: 34px; }
.pnum { font-family: "PlexC"; font-weight: 700; font-size: 20px; color: var(--verde); display: flex; align-items: center; gap: 8px; }
.dark .pnum { color: var(--verde2); }
.pnum::before { content: ""; width: 42px; height: 1px; background: currentColor; }
.title { font-family: "PlexC"; font-weight: 700; font-size: 40px; line-height: 1; text-transform: uppercase; letter-spacing: -0.2px; margin-top: 30px; }
.sub { font-size: 14px; color: var(--tinta2); margin-top: 10px; }
.dark .sub { color: var(--gris); }
.label { font-size: 9.5px; font-weight: 600; letter-spacing: 0.6px; text-transform: uppercase; color: var(--verde); }
.dark .label { color: var(--verde2); }
.foot { position: absolute; left: 56px; right: 56px; bottom: 22px; border-top: 1px solid var(--verde); padding-top: 9px;
        font-size: 8.5px; letter-spacing: 0.5px; text-transform: uppercase; color: var(--tinta2); display: flex; justify-content: space-between; }
.dark .foot { color: var(--gris); border-top-color: var(--borde); }

/* ---------- 1 · portada ---------- */
.cover .left { position: absolute; left: 0; top: 0; bottom: 0; width: 52%; padding: 44px 60px; }
.cover .right { position: absolute; right: 0; top: 0; bottom: 0; width: 48%; border-left: 2px solid var(--verde2);
                background: url("{{ assets }}/portada.jpg") center / cover no-repeat; }
.cover .logo { height: 50px; }
.cover h1 { font-family: "PlexC"; font-weight: 700; font-size: 50px; line-height: 1.02; text-transform: uppercase; margin-top: 170px; }
.cover h1 span { display: block; color: var(--verde2); }
.cover .rule { height: 1px; background: var(--verde); margin: 30px 0 26px; width: 100%; opacity: .8; }
.cover .period { font-family: "PlexC"; font-weight: 600; font-size: 19px; letter-spacing: 1px; }
.cover .who { position: absolute; left: 60px; bottom: 150px; }
.cover .who .name { font-size: 28px; font-weight: 400; margin-top: 8px; }

/* ---------- 2 · resumen ---------- */
.res-rule { height: 1px; background: var(--verde); margin-top: 24px; }
.res { display: grid; grid-template-columns: 1fr 1px 1.35fr; column-gap: 48px; margin-top: 50px; flex: 0 0 auto; }
.res .vline { background: var(--verde); }
.res .blk { padding-bottom: 38px; }
.res .blk + .blk { border-top: 1px solid var(--linea-crema); padding-top: 40px; }
.big { font-family: "PlexC"; font-weight: 600; font-size: 66px; line-height: 1; margin-top: 20px; letter-spacing: -0.5px; }
.big2 { font-size: 52px; }
.note { font-size: 11px; color: var(--tinta2); margin-top: 10px; }
.kpi { padding: 0 0 30px; }
.kpi + .kpi { border-top: 1px solid var(--linea-crema); padding-top: 30px; }
.kpi .row { display: flex; align-items: baseline; margin-top: 12px; }
.kpi .p { font-family: "PlexC"; font-weight: 700; font-size: 52px; line-height: 1; width: 55%; letter-spacing: -0.3px; }
.kpi .u { font-family: "PlexC"; font-weight: 600; font-size: 34px; line-height: 1; }
.fnote { position: absolute; left: 56px; bottom: 58px; font-size: 10px; color: var(--tinta2); }

/* ---------- 3 · evolución ---------- */
.ev-top { display: flex; justify-content: space-between; align-items: flex-start; }
.ev-top .title { margin-top: 26px; }
.saldo { border-left: 1px solid var(--verde); padding: 4px 0 4px 26px; margin-top: 28px; min-width: 300px; }
.saldo .row { display: flex; justify-content: space-between; align-items: baseline; gap: 30px; margin-top: 10px; }
.saldo .d { font-size: 12px; color: var(--gris); }
.saldo .v { font-family: "PlexC"; font-weight: 700; font-size: 26px; }
.chart { margin-top: 14px; }
.chart .gl { stroke: var(--borde); stroke-width: 1; }
.chart .ya { fill: var(--gris); font: 9px "Plex"; text-anchor: end; }
.chart .xa { fill: var(--gris); font: 9px "Plex"; }
.chart .ln { fill: none; stroke: var(--verde2); stroke-width: 2.4; stroke-linejoin: round; stroke-linecap: round; }
.chart .area { fill: var(--verde2); opacity: .07; }
.chart .pt { fill: var(--carbon); stroke: var(--verde2); stroke-width: 1.8; }
.chart .pt.last { fill: var(--crema); stroke: var(--verde2); stroke-width: 2.2; }
.chart .lbl { fill: var(--verde2); font: 600 10.5px "Plex"; }
table { width: 100%; border-collapse: collapse; }
.tev { margin-top: 10px; }
.tev th { font-size: 8.5px; font-weight: 600; letter-spacing: .5px; color: var(--gris); text-align: right; padding: 8px 6px; border-bottom: 1px solid var(--verde2); text-transform: uppercase; }
.tev th:first-child, .tev td:first-child { text-align: left; }
.tev td { font-size: 11px; padding: 6.5px 6px; text-align: right; border-bottom: 1px solid var(--borde); font-variant-numeric: tabular-nums; }
.tev td:first-child { font-weight: 600; }
.tev tr.cur td { background: #151B18; font-weight: 600; }
.tev.denso td { padding: 3.6px 6px; font-size: 10.3px; } .tev.denso + .acum { padding: 8px 18px; }
.acum { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--verde2); background: #131A17; padding: 12px 18px; margin-top: 2px; }
.acum .t { font-family: "PlexC"; font-weight: 600; font-size: 16px; letter-spacing: .5px; }
.acum .vals { display: flex; gap: 70px; font-family: "PlexC"; font-weight: 700; font-size: 25px; }
.fn { font-size: 9.5px; color: var(--gris); margin-top: 9px; }

/* ---------- 4 · operaciones ---------- */
.activos { display: flex; gap: 46px; margin-top: 8px; padding-bottom: 10px; border-bottom: 1px solid var(--verde); }
.activos div { font-size: 12px; color: var(--tinta2); }
.activos b { font-family: "PlexC"; font-weight: 700; font-size: 15px; color: var(--verde); margin-right: 7px; }
.tops th { font-size: 8.5px; font-weight: 600; letter-spacing: .5px; color: var(--tinta2); text-align: left; padding: 8px 6px 6px; border-bottom: 1px solid var(--linea-crema); text-transform: uppercase; }
.tops td { font-size: 10.5px; padding: 3.3px 6px; border-bottom: 1px solid var(--linea-crema); font-variant-numeric: tabular-nums; }
.tops .r { text-align: right; }
.tops td.b { font-weight: 600; }
.tops td.rst { font-weight: 600; font-size: 9.5px; letter-spacing: .4px; }
.tops.holgado td { padding: 8px 6px; font-size: 11px; }
.tops.denso td { padding: 1.8px 6px; font-size: 9.6px; }
.opnote { font-size: 9.5px; color: var(--tinta2); margin-top: 8px; }
.sumbar { position: absolute; left: 56px; right: 56px; bottom: 50px; display: grid; grid-template-columns: repeat(6, 1fr);
          border-top: 1px solid var(--verde); }
.sumbar > div { text-align: center; padding: 7px 4px 6px; }
.sumbar > div + div { border-left: 1px solid var(--linea-crema); }
.sumbar .k { font-size: 8.5px; font-weight: 600; letter-spacing: .6px; color: var(--tinta2); text-transform: uppercase; }
.sumbar .v { font-family: "PlexC"; font-weight: 700; font-size: 23px; margin-top: 2px; line-height: 1.1; }

/* ---------- 5 · contratapa ---------- */
.back .left { position: absolute; left: 0; top: 0; bottom: 0; width: 56%; padding: 44px 60px; }
.back .right { position: absolute; right: 0; top: 0; bottom: 0; width: 44%; border-left: 2px solid var(--verde2);
               background: url("{{ assets }}/contratapa.jpg") center / cover no-repeat; }
.back .logo { height: 58px; }
.back .contact { margin-top: 180px; width: 380px; }
.back .contact .rule { height: 1px; background: var(--verde); margin: 12px 0 22px; }
.back .contact p { font-size: 15px; margin-bottom: 14px; }
.back .contact p.web { color: var(--verde2); }
.back .legal { position: absolute; left: 60px; right: 60px; bottom: 96px; border-top: 1px solid var(--borde); padding-top: 18px; }
.back .legal p { font-size: 10.5px; color: var(--gris); line-height: 1.45; margin-top: 7px; }
.back .mes { position: absolute; left: 60px; bottom: 40px; font-family: "PlexC"; font-weight: 700; font-size: 24px; color: var(--verde2); }
</style>
</head>
<body>

<!-- 1 · PORTADA -->
<section class="page dark cover">
  <div class="left">
    <img class="logo" src="{{ assets }}/logo_dark_bg.png" alt="Winbit">
    <h1>Reporte mensual<span>de rendimiento</span></h1>
    <div class="rule"></div>
    <div class="period">{{ mes_txt }}</div>
    <div class="who">
      <div class="label">Inversor</div>
      <div class="name">{{ inversor }}</div>
    </div>
  </div>
  <div class="right"></div>
</section>

<!-- 2 · RESUMEN -->
<section class="page light">
  <div class="inner">
    <div class="head"><img src="{{ assets }}/logo_light_bg.png" alt="Winbit"><div class="pnum">02</div></div>
    <div class="title">Resumen del portafolio</div>
    <div class="res-rule"></div>
    <div class="res">
      <div>
        <div class="blk">
          <div class="label">Valor del portafolio</div>
          <div class="big">{{ valor }}</div>
          <div class="note">Valor del portafolio al {{ fecha_cierre }}</div>
        </div>
        <div class="blk">
          <div class="label">Capital aportado neto</div>
          <div class="big big2">{{ aportado_neto }}</div>
          <div class="note">Ingresos menos retiros.</div>
        </div>
      </div>
      <div class="vline"></div>
      <div>
        <div class="kpi">
          <div class="label">Rendimiento mensual · {{ mes_txt }}</div>
          <div class="row"><div class="p {{ k_mes[2] }}">{{ k_mes[0] }}</div><div class="u">{{ k_mes[1] }}</div></div>
        </div>
        <div class="kpi">
          <div class="label">Rendimiento acumulado {{ anio }}</div>
          <div class="row"><div class="p {{ k_anio[2] }}">{{ k_anio[0] }}</div><div class="u">{{ k_anio[1] }}</div></div>
        </div>
        <div class="kpi">
          <div class="label">Rendimiento acumulado desde el ingreso</div>
          <div class="row"><div class="p {{ k_ing[2] }}">{{ k_ing[0] }}</div><div class="u">{{ k_ing[1] }}</div></div>
        </div>
      </div>
    </div>
  </div>
  <div class="fnote">Rendimiento neto = rendimiento operativo − costo del servicio aplicado al período.</div>
  <div class="foot"><span>Reporte mensual de rendimiento · {{ mes_txt }}</span><span>{{ inversor }}</span></div>
</section>

<!-- 3 · EVOLUCIÓN -->
<section class="page dark">
  <div class="inner">
    <div class="head"><img src="{{ assets }}/logo_dark_bg.png" alt="Winbit"><div class="pnum">03</div></div>
    <div class="ev-top">
      <div>
        <div class="title">Evolución del portafolio</div>
        <div class="sub">Historial mensual {{ anio }}</div>
      </div>
      <div class="saldo">
        <div class="label">Saldo inicial {{ anio }}</div>
        <div class="row"><span class="d">{{ saldo_ini_fecha }}</span><span class="v">{{ saldo_ini }}</span></div>
      </div>
    </div>
    <div class="label" style="margin-top:18px">Evolución del valor del portafolio</div>
    <div class="chart">{{ grafico|safe }}</div>
    <table class="tev{% if denso %} denso{% endif %}">
      <thead><tr><th>Mes</th><th>Valor portafolio (USD)</th><th>Ingresos (USD)</th><th>Retiros (USD)</th><th>Costo servicio* (USD)</th><th>Rendimiento %</th><th>Rendimiento (USD)</th></tr></thead>
      <tbody>
      {% for f in filas %}
        <tr{% if f.actual %} class="cur"{% endif %}><td>{{ f.mes }}</td><td>{{ f.valor }}</td><td>{{ f.ingresos }}</td><td>{{ f.retiros }}</td><td>{{ f.costo }}</td><td class="{{ f.cls }}">{{ f.pct }}</td><td class="{{ f.cls }}">{{ f.usd }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    <div class="acum"><span class="t">ACUMULADO {{ anio }}</span><span class="vals"><span class="{{ acum_cls }}">{{ acum_pct }}</span><span>{{ acum_usd }}</span></span></div>
    <div class="fn">* Importe correspondiente al servicio de gestión aplicado en el período indicado.</div>
  </div>
  <div class="foot"><span>Reporte mensual de rendimiento · {{ mes_txt }}</span><span>{{ inversor }}</span></div>
</section>

<!-- 4 · OPERACIONES -->
<section class="page light">
  <div class="inner">
    <div class="head"><img src="{{ assets }}/logo_light_bg.png" alt="Winbit"><div class="pnum">04</div></div>
    <div class="title" style="margin-top:22px">Operaciones del mes</div>
    <div class="sub" style="margin-top:6px">Detalle operativo · {{ mes_txt|title }}</div>
    <div class="label" style="margin-top:14px">Activos operados</div>
    <div class="activos">{% for c, n in activos %}<div><b>{{ c }}</b>{{ n }}</div>{% endfor %}</div>
    <table class="tops{% if ops_denso %} denso{% elif ops|length <= 10 %} holgado{% endif %}">
      <thead><tr><th>Fecha</th><th>Activo</th><th>Dirección</th><th class="r">Apertura</th><th class="r">Cierre</th><th class="r">Resultado</th><th class="r">Rend. %</th><th class="r">USD</th><th class="r">Ratio</th></tr></thead>
      <tbody>
      {% for o in ops %}
        <tr><td class="b">{{ o.fecha }}</td><td class="b">{{ o.activo }}</td><td>{{ o.direccion }}</td><td class="r">{{ o.apertura }}</td><td class="r">{{ o.cierre }}</td><td class="r rst {{ o.cls }}">{{ o.resultado }}</td><td class="r {{ o.cls }}">{{ o.pct }}</td><td class="r b {{ o.usd_cls }}">{{ o.usd }}</td><td class="r b">{{ o.ratio }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    <div class="opnote">Ratio: relación entre el resultado de la operación y el riesgo inicialmente asumido. BE: break even (resultado cercano a cero). USD: resultado atribuido a esta cuenta.</div>
  </div>
  <div class="sumbar">
    <div><div class="k">Operaciones</div><div class="v">{{ n_ops }}</div></div>
    <div><div class="k">Positivas</div><div class="v pos">{{ n_pos }}</div></div>
    <div><div class="k">Negativas</div><div class="v neg">{{ n_neg }}</div></div>
    <div><div class="k">Break even</div><div class="v neu">{{ n_be }}</div></div>
    <div><div class="k">Resultado neto</div><div class="v {{ k_mes[2] }}">{{ neto_mes }}</div></div>
    <div><div class="k">Rendimiento del mes</div><div class="v {{ k_mes[2] }}">{{ rend_mes }}</div></div>
  </div>
  <div class="foot"><span>Reporte mensual de rendimiento · {{ mes_txt }}</span><span>{{ inversor }}</span></div>
</section>

<!-- 5 · CONTRATAPA -->
<section class="page dark back">
  <div class="left">
    <img class="logo" src="{{ assets }}/logo_dark_bg.png" alt="Winbit">
    <div class="contact">
      <div class="label">Contacto</div>
      <div class="rule"></div>
      <p>+54 9 11 4178-3126</p>
      <p>winbit.cfds@gmail.com</p>
      <p class="web">winbit.com.ar</p>
    </div>
    <div class="legal">
      <div class="label">Información legal</div>
      <p>Este documento es confidencial y fue emitido para uso exclusivo del titular del portafolio.</p>
      <p>Material informativo. La operatoria con derivados implica riesgo y los resultados pueden variar según las condiciones de mercado.</p>
      <p>Resultados históricos. No garantizan resultados futuros.</p>
    </div>
    <div class="mes">{{ mes_txt }}</div>
  </div>
  <div class="right"></div>
</section>

</body>
</html>
